diff --git a/Platform/Radxa/Orion/O6/Library/PciOptionRomPolicyLib/PciOptionRomPolicyLib.c b/Platform/Radxa/Orion/O6/Library/PciOptionRomPolicyLib/PciOptionRomPolicyLib.c
new file mode 100644
index 0000000000000000000000000000000000000000..4e510b8f84f0a9034858d215f145c622112e06a9
--- /dev/null
+++ b/Platform/Radxa/Orion/O6/Library/PciOptionRomPolicyLib/PciOptionRomPolicyLib.c
@@ -0,0 +1,76 @@
+/** @file
+  Orion O6 PCI option ROM policy.
+
+  Copyright 2026 Radxa Computer (Shenzhen) Co., Ltd. All Rights Reserved.
+
+  SPDX-License-Identifier: BSD-2-Clause-Patent
+**/
+
+#include <Uefi.h>
+#include <IndustryStandard/Pci.h>
+#include <Library/BaseMemoryLib.h>
+#include <Library/DebugLib.h>
+#include <Library/PciOptionRomPolicyLib.h>
+#include <Library/UefiRuntimeServicesTableLib.h>
+#include <RadxaSetupVar.h>
+
+#define LSI_BROADCOM_PCI_VENDOR_ID  0x1000
+
+BOOLEAN
+EFIAPI
+PlatformShouldIgnorePciOptionRom (
+  IN UINT16  VendorId,
+  IN UINT16  DeviceId,
+  IN UINT8   BaseClass,
+  IN UINT8   SubClass,
+  IN UINT8   Bus,
+  IN UINT8   Device,
+  IN UINT8   Function
+  )
+{
+  EFI_STATUS        Status;
+  UINTN             VarSize;
+  RADXA_SETUP_DATA  RadxaSetupVar;
+
+  //
+  // Temporary broad match until the affected adapter's exact Device ID is
+  // known. Restrict it to LSI/Broadcom mass-storage controllers.
+  //
+  if ((VendorId != LSI_BROADCOM_PCI_VENDOR_ID) ||
+      (BaseClass != PCI_CLASS_MASS_STORAGE))
+  {
+    return FALSE;
+  }
+
+  ZeroMem (&RadxaSetupVar, sizeof (RadxaSetupVar));
+  VarSize = sizeof (RadxaSetupVar);
+  Status  = gRT->GetVariable (
+                   RADXA_SETUP_VAR,
+                   &gRadxaSetupVariableGuid,
+                   NULL,
+                   &VarSize,
+                   &RadxaSetupVar
+                   );
+  if (EFI_ERROR (Status) ||
+      (VarSize < OFFSET_OF (RADXA_SETUP_DATA, IgnoreLsiOptionRom) +
+                 sizeof (RadxaSetupVar.IgnoreLsiOptionRom)) ||
+      (RadxaSetupVar.IgnoreLsiOptionRom == 0))
+  {
+    return FALSE;
+  }
+
+  DEBUG ((
+    DEBUG_WARN,
+    "PCI QUIRK: skipping LSI/Broadcom option ROM for %04x:%04x "
+    "class %02x:%02x at %02x:%02x.%x\n",
+    VendorId,
+    DeviceId,
+    BaseClass,
+    SubClass,
+    Bus,
+    Device,
+    Function
+    ));
+
+  return TRUE;
+}
