diff --git a/Platform/CIX/Sky1/Include/Library/PciOptionRomPolicyLib.h b/Platform/CIX/Sky1/Include/Library/PciOptionRomPolicyLib.h
new file mode 100644
index 0000000000000000000000000000000000000000..e8ccbd83691c7be13e5a37c7d2a016f5b637bb31
--- /dev/null
+++ b/Platform/CIX/Sky1/Include/Library/PciOptionRomPolicyLib.h
@@ -0,0 +1,42 @@
+/** @file
+  Platform policy for suppressing PCI option ROM probing.
+
+  Copyright 2026 Radxa Computer (Shenzhen) Co., Ltd. All Rights Reserved.
+
+  SPDX-License-Identifier: BSD-2-Clause-Patent
+**/
+
+#ifndef PCI_OPTION_ROM_POLICY_LIB_H_
+#define PCI_OPTION_ROM_POLICY_LIB_H_
+
+#include <Uefi.h>
+
+/**
+  Return whether PCI Bus should skip option ROM probing for a device.
+
+  The device remains fully enumerated and its resources are still assigned.
+
+  @param[in] VendorId   PCI vendor identifier.
+  @param[in] DeviceId   PCI device identifier.
+  @param[in] BaseClass  PCI base class code.
+  @param[in] SubClass   PCI subclass code.
+  @param[in] Bus        PCI bus number.
+  @param[in] Device     PCI device number.
+  @param[in] Function   PCI function number.
+
+  @retval TRUE   Skip option ROM probing.
+  @retval FALSE  Use the normal PCI Bus option ROM policy.
+**/
+BOOLEAN
+EFIAPI
+PlatformShouldIgnorePciOptionRom (
+  IN UINT16  VendorId,
+  IN UINT16  DeviceId,
+  IN UINT8   BaseClass,
+  IN UINT8   SubClass,
+  IN UINT8   Bus,
+  IN UINT8   Device,
+  IN UINT8   Function
+  );
+
+#endif
